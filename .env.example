APP_NAME="Satis Manager"
APP_ENV=dev
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VENDOR=vendor

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Default Admin User Email (required for initial setup)
DEFAULT_ADMIN_EMAIL=

# Satis Configuration
SATIS_ARCHIVE=true

# Github (optional)
GITHUB_TOKEN=

# Gitlab (optional)
GITLAB_TOKEN=

# Bitbucket (optional)
BITBUCKET_KEY=votre_consumer_key
BITBUCKET_TOKEN=votre_consumer_secret

# Custom Provider (ex: GitLab self-hosted, Gitea, etc. - optional)
CUSTOM_PROVIDER_TOKEN=votre_token
CUSTOM_PROVIDER_DOMAIN=git.votredomaine.com
CUSTOM_PROVIDER_USERNAME=git  # optionnel, défaut: "token"
